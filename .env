# Root env file for `docker compose`. Every value here is either a real local
# service (Postgres/Azurite/Mailpit/stripe-mock) or a harmless placeholder for
# a cloud-only credential that MOCK_EXTERNAL_SERVICES=true means never gets used.

# ---- Local Postgres ----
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=redaxify_dev
DATABASE_URL=postgresql://postgres:postgres@db:5432/redaxify_dev?schema=public
DIRECT_URL=postgresql://postgres:postgres@db:5432/redaxify_dev?schema=public

# ---- Local Azurite (Azure Blob Storage emulator) ----
# This is Microsoft's published well-known emulator key, not a secret.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER_NAME=videos
AZURE_CONTAINER_NAME=videos
NEXT_PUBLIC_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
NEXT_PUBLIC_AZURE_STORAGE_CONTAINER_NAME=videos

# ---- Local Mailpit (SMTP catcher, UI at http://localhost:8025) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Local stripe-mock (server-side Stripe API calls only; see README note) ----
STRIPE_API_HOST=stripe-mock
STRIPE_API_PROTOCOL=http
STRIPE_API_PORT=12111
STRIPE_SECRET_KEY=sk_test_mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock

# ---- Fully-offline switch ----
# When true, all Azure Video Indexer / Form Recognizer / OpenAI calls return
# canned data instead of hitting the real cloud services.
MOCK_EXTERNAL_SERVICES=true

# ---- CORS / URLs between local containers ----
FRONTEND_ORIGIN=http://localhost:3000
LOCAL_FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_REDAXIFY_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DOMAIN=http://localhost:4000

# ---- App-level secrets (JWT/session signing, not cloud credentials) ----
AUTH_SECRET=FYDUIuie14dweuwefuiuhf45486456
NEXTAUTH_SECRET=Redaxify
TOKEN_SECRET=Redaxify

# ---- Email sender identity (used as the "From" address via Mailpit) ----
EMAIL=dev@redaxify.local
EMAIL_PASSWORD=
GMAIL_APP_PASSWORD=

# ---- Azure Video Indexer / Form Recognizer / OpenAI ----
# Placeholders only: MOCK_EXTERNAL_SERVICES=true means these are never sent
# over the network. Set real values here (and flip the switch above) if you
# ever want to hit the real Azure services from local dev.
API_ENDPOINT=https://api.videoindexer.ai
LOCATION=centralus
CLIENT_ID=mock-client-id
CLIENT_SECRET=mock-client-secret
TENANT_ID=mock-tenant-id
SUBSCRIPTION_ID=mock-subscription-id
RESOURCE_GROUP=mock-resource-group
VI_ACCOUNT_ID=mock-vi-account-id
VI_ACCOUNT_NAME=mock-vi-account-name
AZURE_FORM_RECOGNIZER_KEY=mock-form-recognizer-key
AZURE_FORM_RECOGNIZER_ENDPOINT=https://mock.cognitiveservices.azure.com
AZURE_CV_KEY=mock-cv-key
AZURE_CV_ENDPOINT=https://mock.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=mock-openai-key
AZURE_OPENAI_ENDPOINT=https://mock.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=mock-deployment
OPENAI_API_VERSION=2024-02-15-preview

NEXT_PUBLIC_API_ENDPOINT=https://api.videoindexer.ai
NEXT_PUBLIC_LOCATION=centralus
NEXT_PUBLIC_CLIENT_ID=mock-client-id
NEXT_PUBLIC_CLIENT_SECRET=mock-client-secret
NEXT_PUBLIC_TENANT_ID=mock-tenant-id
NEXT_PUBLIC_SUBSCRIPTION_ID=mock-subscription-id
NEXT_PUBLIC_RESOURCE_GROUP=mock-resource-group
NEXT_PUBLIC_VI_ACCOUNT_ID=mock-vi-account-id
NEXT_PUBLIC_VI_ACCOUNT_NAME=mock-vi-account-name
NEXT_PUBLIC_VI_LOCATION=centralus
NEXT_PUBLIC_AZURE_OPENAI_API_KEY=mock-openai-key
NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT=https://mock.openai.azure.com
NEXT_PUBLIC_AZURE_OPENAI_DEPLOYMENT_NAME=mock-deployment
NEXT_PUBLIC_OPENAI_API_VERSION=2024-02-15-preview

# ---- Google OAuth ----
# Left unset: this was already unconfigured before this change (not a
# regression). Set both to enable "Sign in with Google" (still needs a real
# Google Cloud OAuth app; this cannot be emulated locally).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
