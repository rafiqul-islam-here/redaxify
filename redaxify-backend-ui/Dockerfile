# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# ---- deps ----
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN NODE_OPTIONS=--dns-result-order=ipv4first npm ci --legacy-peer-deps

# ---- builder ----
FROM base AS builder
WORKDIR /app

# Next.js inlines NEXT_PUBLIC_* vars into the client bundle at build time,
# so they must be passed as build args (docker-compose supplies them from .env).
ARG NEXT_PUBLIC_REDAXIFY_BACKEND_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_AZURE_STORAGE_CONTAINER_NAME
ARG NEXT_PUBLIC_AZURE_STORAGE_CONNECTION_STRING
ARG NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT
ARG NEXT_PUBLIC_AZURE_OPENAI_API_KEY
ARG NEXT_PUBLIC_AZURE_OPENAI_DEPLOYMENT_NAME
ARG NEXT_PUBLIC_OPENAI_API_VERSION
ARG NEXT_PUBLIC_API_ENDPOINT
ARG NEXT_PUBLIC_LOCATION
ARG NEXT_PUBLIC_CLIENT_ID
ARG NEXT_PUBLIC_CLIENT_SECRET
ARG NEXT_PUBLIC_TENANT_ID
ARG NEXT_PUBLIC_SUBSCRIPTION_ID
ARG NEXT_PUBLIC_RESOURCE_GROUP
ARG NEXT_PUBLIC_VI_ACCOUNT_ID
ARG NEXT_PUBLIC_VI_ACCOUNT_NAME
ARG NEXT_PUBLIC_VI_LOCATION
ENV NEXT_PUBLIC_REDAXIFY_BACKEND_URL=$NEXT_PUBLIC_REDAXIFY_BACKEND_URL \
    NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_AZURE_STORAGE_CONTAINER_NAME=$NEXT_PUBLIC_AZURE_STORAGE_CONTAINER_NAME \
    NEXT_PUBLIC_AZURE_STORAGE_CONNECTION_STRING=$NEXT_PUBLIC_AZURE_STORAGE_CONNECTION_STRING \
    NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT=$NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT \
    NEXT_PUBLIC_AZURE_OPENAI_API_KEY=$NEXT_PUBLIC_AZURE_OPENAI_API_KEY \
    NEXT_PUBLIC_AZURE_OPENAI_DEPLOYMENT_NAME=$NEXT_PUBLIC_AZURE_OPENAI_DEPLOYMENT_NAME \
    NEXT_PUBLIC_OPENAI_API_VERSION=$NEXT_PUBLIC_OPENAI_API_VERSION \
    NEXT_PUBLIC_API_ENDPOINT=$NEXT_PUBLIC_API_ENDPOINT \
    NEXT_PUBLIC_LOCATION=$NEXT_PUBLIC_LOCATION \
    NEXT_PUBLIC_CLIENT_ID=$NEXT_PUBLIC_CLIENT_ID \
    NEXT_PUBLIC_CLIENT_SECRET=$NEXT_PUBLIC_CLIENT_SECRET \
    NEXT_PUBLIC_TENANT_ID=$NEXT_PUBLIC_TENANT_ID \
    NEXT_PUBLIC_SUBSCRIPTION_ID=$NEXT_PUBLIC_SUBSCRIPTION_ID \
    NEXT_PUBLIC_RESOURCE_GROUP=$NEXT_PUBLIC_RESOURCE_GROUP \
    NEXT_PUBLIC_VI_ACCOUNT_ID=$NEXT_PUBLIC_VI_ACCOUNT_ID \
    NEXT_PUBLIC_VI_ACCOUNT_NAME=$NEXT_PUBLIC_VI_ACCOUNT_NAME \
    NEXT_PUBLIC_VI_LOCATION=$NEXT_PUBLIC_VI_LOCATION

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate
RUN npm run build

# ---- runner ----
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
